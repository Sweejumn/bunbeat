# RunBPM backend environment variables (copy to .env or export in shell)

# Where uploaded/processed audio and the SQLite DB live (relative to backend/)
RUNBPM_DATA_DIR=./data

# Per-file upload cap in MB
RUNBPM_MAX_UPLOAD_MB=100

# BPM analysis workers
RUNBPM_MAX_CONCURRENT_ANALYZE=2

# FFmpeg time-stretch workers
RUNBPM_MAX_CONCURRENT_PROCESS=1

# Optional explicit ffmpeg binary. If unset, `ffmpeg` on PATH is used,
# then the static binary bundled with the imageio-ffmpeg package.
#RUNBPM_FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe
