# RunBPM 后端环境变量示例（复制为 backend/.env 或在 shell 中导出）
# 所有变量均可选，未设置时使用默认值

# 数据目录（上传音频、处理结果、SQLite 数据库），相对 backend/ 目录
RUNBPM_DATA_DIR=./data

# 单文件上传大小上限（MB）
RUNBPM_MAX_UPLOAD_MB=100

# BPM 分析并发 worker 数
RUNBPM_MAX_CONCURRENT_ANALYZE=2

# FFmpeg 变速处理并发 worker 数（避免 CPU 被占满）
RUNBPM_MAX_CONCURRENT_PROCESS=1

# 可选：指定 ffmpeg 可执行文件路径。
# 未设置时依次尝试：PATH 中的 ffmpeg → imageio-ffmpeg 自带的静态构建
#RUNBPM_FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe
