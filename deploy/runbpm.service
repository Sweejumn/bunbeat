[Unit]
Description=RunBPM — BPM 跑步音乐播放器后端
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=runbpm
Group=runbpm
WorkingDirectory=/opt/runbpm/backend
# 数据目录独立于代码目录：升级代码时歌曲 / 处理结果 / 数据库不丢
Environment=RUNBPM_DATA_DIR=/opt/runbpm/data
# 小内存服务器（1GB）建议并发 1；2GB 以上可以改成 2/1（即删掉这两行）
Environment=RUNBPM_MAX_CONCURRENT_ANALYZE=1
Environment=RUNBPM_MAX_CONCURRENT_PROCESS=1
# 0.0.0.0 = 直接对外提供 8000 端口；若用 nginx 反代请改成 127.0.0.1
ExecStart=/opt/runbpm/backend/.venv/bin/python run.py 0.0.0.0
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
